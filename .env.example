# =============================================================================
# NEXO PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# -----------------------------------------------------------------------------
# AI ENGINE PROVIDER (auto | litert_hybrid | litert | local | gemini | mock)
# -----------------------------------------------------------------------------
AI_PROVIDER=auto

# LiteRT-LM Hybrid Configuration (MiniCPM-V 4.7 1B for Vision + Gemma 4 26B for Reasoning)
LITERT_VISION_URL=http://127.0.0.1:11436
LITERT_VISION_MODEL=minicpm-v4.7-1b
LITERT_REASONING_URL=http://127.0.0.1:11435
LITERT_REASONING_MODEL=gemma4-26b

# LiteRT-LM Embeddings (Nexo-Palace Engine) — motor local para el índice vectorial
LITERT_EMBED_URL=http://127.0.0.1:11435
LITERT_EMBEDDING_MODEL=nomic-embed-text

# Ollama Local Configuration (Qwen3-VL / MiniCPM-V 35B)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8B

# Google Gemini API (Cloud Fallback)
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# SUPABASE POSTGRESQL & ROW LEVEL SECURITY (RLS) CONFIGURATION
# -----------------------------------------------------------------------------
# Public REST / Auth Endpoint for your Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (Safe for browser / client exposure, strictly gated by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Service Role key (Bypasses RLS, NEVER expose in client bundles)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# Public base URL (used for Auth callback redirects and QR code generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000
